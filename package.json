{
  "name": "clube04-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM operacional do Clube04 Mogi das Cruzes.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @clube04/api",
    "build": "npm run build -w @clube04/shared && npm run build -w @clube04/api && npm run build -w @clube04/worker && npm run build -w @clube04/web",
    "start": "npm run start -w @clube04/api",
    "worker": "npm run dev -w @clube04/worker",
    "lint": "npm run lint -w @clube04/shared && npm run lint -w @clube04/api && npm run lint -w @clube04/worker && npm run lint -w @clube04/web",
    "smoke:api": "tsx scripts/smoke/smoke-api.ts",
    "verify:action-items": "tsx scripts/verify/verify-action-items-lifecycle.ts",
    "verify:operational-summary": "tsx scripts/verify/verify-operational-summary.ts",
    "verify:operational-worklist": "tsx scripts/verify/verify-operational-worklist.ts",
    "verify:lead-operational-cycle": "tsx scripts/verify/verify-lead-operational-cycle.ts",
    "verify:lead-operational-scenarios": "tsx scripts/verify/verify-lead-operational-scenarios.ts",
    "verify:dashboard": "tsx scripts/verify/verify-dashboard.ts",
    "verify:frontend": "playwright test",
    "verify:data-cleanliness": "tsx scripts/verify/verify-data-cleanliness.ts",
    "verify:all": "tsx scripts/verify/run-verify-all.ts",
    "verify:all:no-cleanup": "tsx scripts/verify/run-verify-all.ts --no-cleanup",
    "analyze:lead-spreadsheet": "tsx scripts/imports/lead-spreadsheet/analyze-lead-spreadsheet.ts",
    "import:lead-spreadsheet:dry-run": "tsx scripts/imports/lead-spreadsheet/import-lead-spreadsheet-dry-run.ts",
    "import:lead-spreadsheet:crosscheck-dry-run": "tsx scripts/imports/lead-spreadsheet/import-lead-spreadsheet-crosscheck-dry-run.ts",
    "import:lead-spreadsheet:apply": "tsx scripts/imports/lead-spreadsheet/import-lead-spreadsheet-apply.ts",
    "remediate:lead-import-worklist": "tsx scripts/remediation/remediate-lead-import-worklist.ts",
    "dev:cleanup-test-data": "tsx scripts/dev-data/dev-cleanup-test-data.ts",
    "dev:cleanup-test-data:apply": "tsx scripts/dev-data/dev-cleanup-test-data.ts --apply --confirm-local-dev",
    "dev:diagnose-imported-leads": "tsx scripts/dev-data/dev-diagnose-imported-leads.ts",
    "dev:reset-imported-leads": "tsx scripts/dev-data/dev-reset-imported-leads.ts",
    "dev:reset-imported-leads:apply": "tsx scripts/dev-data/dev-reset-imported-leads.ts --apply --confirm-local-dev",
    "dev:seed-dashboard": "tsx scripts/dev-data/dev-seed-dashboard.ts",
    "n8n:import:workflows": "docker compose exec -T n8n n8n import:workflow --separate --input=/workflows",
    "n8n:list:workflows": "docker compose exec -T n8n n8n list:workflow"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
